package huaiwei.platform

import std.unittest.*
import std.unittest.testmacro.*

@Test
class CryptoTests {
    @TestCase
    func pbkdf2PublishedVector() {
        // RFC 7914 section 11, PBKDF2-HMAC-SHA256 first 32 bytes, c=1.
        let actual = pbkdf2Sha256("passwd".toArray(), "salt".toArray(), 1)
        let expected: Array<UInt8> = [0x55,0xac,0x04,0x6e,0x56,0xe3,0x08,0x9f,
            0xec,0x16,0x91,0xc2,0x25,0x44,0xb6,0x05,0xf9,0x41,0x85,0x21,
            0x6d,0xde,0x04,0x65,0xe6,0x8b,0x9d,0x57,0xc2,0x0d,0xac,0xbc]
        @Expect(actual, expected)
    }
}
