public class RecommendationJob {
    public var id: String
    public var sessionId: String
    public var requesterId: String
    public var requestId: String
    public var roomVersion: Int64
    public var menuVersion: Int64
    public var startedAt: Int64
    public var status: String
    public var adjustment: ?String
    public var text: ?String

    public init(id!: String = "",
        sessionId!: String = "",
        requesterId!: String = "",
        requestId!: String = "",
        roomVersion!: Int64 = 0,
        menuVersion!: Int64 = 0,
        startedAt!: Int64 = 0,
        status!: String = "inProgress",
        adjustment!: ?String = None,
        text!: ?String = None) {
        this.id = id
        this.sessionId = sessionId
        this.requesterId = requesterId
        this.requestId = requestId
        this.roomVersion = roomVersion
        this.menuVersion = menuVersion
        this.startedAt = startedAt
        this.status = status
        this.adjustment = adjustment
        this.text = text
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("id", JsonString(id))
        obj.put("sessionId", JsonString(sessionId))
        obj.put("requesterId", JsonString(requesterId))
        obj.put("requestId", JsonString(requestId))
        obj.put("roomVersion", JsonInt(roomVersion))
        obj.put("menuVersion", JsonInt(menuVersion))
        obj.put("startedAt", JsonInt(startedAt))
        obj.put("status", JsonString(status))
        obj.put("adjustment", match (adjustment) { case Some(v) => JsonString(v); case None => JsonNull() })
        obj.put("text", match (text) { case Some(v) => JsonString(v); case None => JsonNull() })
        return obj
    }

    public static func fromJson(obj: JsonObject): RecommendationJob {
        return RecommendationJob(id: obj["id"].asString().getValue(),
            sessionId: obj["sessionId"].asString().getValue(),
            requesterId: obj["requesterId"].asString().getValue(),
            requestId: obj["requestId"].asString().getValue(),
            roomVersion: obj["roomVersion"].asInt().getValue(),
            menuVersion: obj["menuVersion"].asInt().getValue(),
            startedAt: obj["startedAt"].asInt().getValue(),
            status: obj["status"].asString().getValue(),
            adjustment: match (obj["adjustment"]) { case _: JsonNull => None; case _ => Some(obj["adjustment"].asString().getValue()) },
            text: match (obj["text"]) { case _: JsonNull => None; case _ => Some(obj["text"].asString().getValue()) })
    }
}

public class IngredientAssociation {
