public class MenuSnapshot {
    public var mealMetadata: Array<DishMealFacts>
    public var restaurant: Restaurant
    public var menuVersion: Int64
    public var dishes: Array<Dish>
    public var setMeals: Array<SetMeal>

    public init(mealMetadata!: Array<DishMealFacts> = [],
        restaurant!: Restaurant = Restaurant(),
        menuVersion!: Int64 = 0,
        dishes!: Array<Dish> = [],
        setMeals!: Array<SetMeal> = []) {
        this.mealMetadata = mealMetadata
        this.restaurant = restaurant
        this.menuVersion = menuVersion
        this.dishes = dishes
        this.setMeals = setMeals
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("mealMetadata", JsonArray(mealMetadata.map({item => item.toJson() })))
        obj.put("restaurant", restaurant.toJson())
        obj.put("menuVersion", JsonInt(menuVersion))
        obj.put("dishes", JsonArray(dishes.map({item => item.toJson() })))
        obj.put("setMeals", JsonArray(setMeals.map({item => item.toJson() })))
        return obj
    }

    public static func fromJson(obj: JsonObject): MenuSnapshot {
        return MenuSnapshot(mealMetadata: if (obj.containsKey("mealMetadata")) { obj["mealMetadata"].asArray().getItems().toArray().map({item => DishMealFacts.fromJson(item.asObject()) }) } else { [] },
            restaurant: Restaurant.fromJson(obj["restaurant"].asObject()),
            menuVersion: obj["menuVersion"].asInt().getValue(),
            dishes: obj["dishes"].asArray().getItems().toArray().map({item => Dish.fromJson(item.asObject()) }),
            setMeals: obj["setMeals"].asArray().getItems().toArray().map({item => SetMeal.fromJson(item.asObject()) }))
    }
}

public class Session {
    public var id: String
    public var roomCode: String
    public var restaurantId: String
    public var hostParticipantId: String
    public var state: String
    public var people: Int64
    public var budgetPerPersonFen: ?Int64
    public var stateVersion: Int64
    public var menuVersion: Int64
    public var createdAt: Int64
    public var expiresAt: Int64
    public var recommendationInvalid: Bool

    public init(id!: String = "",
        roomCode!: String = "",
        restaurantId!: String = "",
        hostParticipantId!: String = "",
        state!: String = "open",
        people!: Int64 = 4,
        budgetPerPersonFen!: ?Int64 = None,
        stateVersion!: Int64 = 1,
        menuVersion!: Int64 = 0,
        createdAt!: Int64 = 0,
        expiresAt!: Int64 = 0,
        recommendationInvalid!: Bool = false) {
        this.id = id
        this.roomCode = roomCode
        this.restaurantId = restaurantId
        this.hostParticipantId = hostParticipantId
        this.state = state
        this.people = people
        this.budgetPerPersonFen = budgetPerPersonFen
        this.stateVersion = stateVersion
        this.menuVersion = menuVersion
        this.createdAt = createdAt
        this.expiresAt = expiresAt
        this.recommendationInvalid = recommendationInvalid
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("id", JsonString(id))
        obj.put("roomCode", JsonString(roomCode))
        obj.put("restaurantId", JsonString(restaurantId))
        obj.put("hostParticipantId", JsonString(hostParticipantId))
        obj.put("state", JsonString(state))
        obj.put("people", JsonInt(people))
        obj.put("budgetPerPersonFen", match (budgetPerPersonFen) { case Some(v) => JsonInt(v); case None => JsonNull() })
        obj.put("stateVersion", JsonInt(stateVersion))
        obj.put("menuVersion", JsonInt(menuVersion))
        obj.put("createdAt", JsonInt(createdAt))
        obj.put("expiresAt", JsonInt(expiresAt))
        obj.put("recommendationInvalid", JsonBool(recommendationInvalid))
        return obj
    }

    public static func fromJson(obj: JsonObject): Session {
        return Session(id: obj["id"].asString().getValue(),
            roomCode: obj["roomCode"].asString().getValue(),
            restaurantId: obj["restaurantId"].asString().getValue(),
            hostParticipantId: obj["hostParticipantId"].asString().getValue(),
            state: obj["state"].asString().getValue(),
            people: obj["people"].asInt().getValue(),
            budgetPerPersonFen: match (obj["budgetPerPersonFen"]) { case _: JsonNull => None; case _ => Some(obj["budgetPerPersonFen"].asInt().getValue()) },
            stateVersion: obj["stateVersion"].asInt().getValue(),
            menuVersion: obj["menuVersion"].asInt().getValue(),
            createdAt: obj["createdAt"].asInt().getValue(),
            expiresAt: obj["expiresAt"].asInt().getValue(),
            recommendationInvalid: obj["recommendationInvalid"].asBool().getValue())
    }
}

public class Participant {
    public var id: String
    public var sessionId: String
    public var userId: ?String
    public var visitorId: ?String
    public var nickname: String
    public var avatarColor: ?String
    public var submitted: Bool
    public var preferences: Preferences
    public var draft: Preferences
    public var joinedAt: Int64
    public var source: String
    public var filledByParticipantId: ?String

    public init(id!: String = "",
        sessionId!: String = "",
        userId!: ?String = None,
        visitorId!: ?String = None,
        nickname!: String = "",
        avatarColor!: ?String = None,
        submitted!: Bool = false,
        preferences!: Preferences = Preferences(),
        draft!: Preferences = Preferences(),
        joinedAt!: Int64 = 0,
        source!: String = "self",
        filledByParticipantId!: ?String = None) {
        this.id = id
        this.sessionId = sessionId
        this.userId = userId
        this.visitorId = visitorId
        this.nickname = nickname
        this.avatarColor = avatarColor
        this.submitted = submitted
        this.preferences = preferences
        this.draft = draft
        this.joinedAt = joinedAt
        this.source = source
        this.filledByParticipantId = filledByParticipantId
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("id", JsonString(id))
        obj.put("sessionId", JsonString(sessionId))
        obj.put("userId", match (userId) { case Some(v) => JsonString(v); case None => JsonNull() })
        obj.put("visitorId", match (visitorId) { case Some(v) => JsonString(v); case None => JsonNull() })
        obj.put("nickname", JsonString(nickname))
        obj.put("avatarColor", match (avatarColor) { case Some(v) => JsonString(v); case None => JsonNull() })
        obj.put("submitted", JsonBool(submitted))
        obj.put("preferences", preferences.toJson())
        obj.put("draft", draft.toJson())
        obj.put("joinedAt", JsonInt(joinedAt))
        obj.put("source", JsonString(source))
        obj.put("filledByParticipantId", match (filledByParticipantId) { case Some(v) => JsonString(v); case None => JsonNull() })
        return obj
    }

    public static func fromJson(obj: JsonObject): Participant {
        return Participant(id: obj["id"].asString().getValue(),
            sessionId: obj["sessionId"].asString().getValue(),
            userId: match (obj["userId"]) { case _: JsonNull => None; case _ => Some(obj["userId"].asString().getValue()) },
            visitorId: match (obj["visitorId"]) { case _: JsonNull => None; case _ => Some(obj["visitorId"].asString().getValue()) },
            nickname: obj["nickname"].asString().getValue(),
            avatarColor: match (obj["avatarColor"]) { case _: JsonNull => None; case _ => Some(obj["avatarColor"].asString().getValue()) },
            submitted: obj["submitted"].asBool().getValue(),
            preferences: Preferences.fromJson(obj["preferences"].asObject()),
            draft: Preferences.fromJson(obj["draft"].asObject()),
            joinedAt: obj["joinedAt"].asInt().getValue(),
            source: obj["source"].asString().getValue(),
            filledByParticipantId: match (obj["filledByParticipantId"]) { case _: JsonNull => None; case _ => Some(obj["filledByParticipantId"].asString().getValue()) })
    }
}

