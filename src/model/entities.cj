    public var isSignature: Bool

    public init(id!: String = "",
        restaurantId!: String = "",
        name!: String = "",
        description!: String = "",
        taste!: String = "",
        cookingMethod!: String = "",
        priceFen!: Int64 = 0,
        imageUrl!: String = "",
        category!: String = "hot",
        ingredients!: Array<String> = [],
        spiceLevel!: Int64 = 0,
        available!: Bool = true,
        isSignature!: Bool = false) {
        this.id = id
        this.restaurantId = restaurantId
        this.name = name
        this.description = description
        this.taste = taste
        this.cookingMethod = cookingMethod
        this.priceFen = priceFen
        this.imageUrl = imageUrl
        this.category = category
        this.ingredients = ingredients
        this.spiceLevel = spiceLevel
        this.available = available
        this.isSignature = isSignature
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("id", JsonString(id))
        obj.put("restaurantId", JsonString(restaurantId))
        obj.put("name", JsonString(name))
        obj.put("description", JsonString(description))
        obj.put("taste", JsonString(taste))
        obj.put("cookingMethod", JsonString(cookingMethod))
        obj.put("priceFen", JsonInt(priceFen))
        obj.put("imageUrl", JsonString(imageUrl))
        obj.put("category", JsonString(category))
        obj.put("ingredients", JsonArray(ingredients.map({item => JsonString(item) })))
        obj.put("spiceLevel", JsonInt(spiceLevel))
        obj.put("available", JsonBool(available))
        obj.put("isSignature", JsonBool(isSignature))
        return obj
    }

    public static func fromJson(obj: JsonObject): Dish {
        return Dish(id: obj["id"].asString().getValue(),
            restaurantId: obj["restaurantId"].asString().getValue(),
            name: obj["name"].asString().getValue(),
            description: obj["description"].asString().getValue(),
            taste: obj["taste"].asString().getValue(),
            cookingMethod: obj["cookingMethod"].asString().getValue(),
            priceFen: obj["priceFen"].asInt().getValue(),
            imageUrl: obj["imageUrl"].asString().getValue(),
            category: obj["category"].asString().getValue(),
            ingredients: obj["ingredients"].asArray().getItems().toArray().map({item => item.asString().getValue() }),
            spiceLevel: obj["spiceLevel"].asInt().getValue(),
            available: obj["available"].asBool().getValue(),
            isSignature: obj["isSignature"].asBool().getValue())
    }
}

