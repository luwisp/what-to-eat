public class RoomSnapshot {
    public var session: Session
    public var restaurantCode: String
    public var stateVersion: Int64
    public var menuVersion: Int64
    public var members: Array<ParticipantView>
    public var self: ?Participant
    public var recommendation: ?Recommendation
    public var recommendationInvalid: Bool
    public var job: ?RecommendationJob
    public var messages: Array<ChatMessage>

    public init(session!: Session = Session(),
        restaurantCode!: String = "",
        stateVersion!: Int64 = 0,
        menuVersion!: Int64 = 0,
        members!: Array<ParticipantView> = [],
        self!: ?Participant = None,
        recommendation!: ?Recommendation = None,
        recommendationInvalid!: Bool = false,
        job!: ?RecommendationJob = None,
        messages!: Array<ChatMessage> = []) {
        this.session = session
        this.restaurantCode = restaurantCode
        this.stateVersion = stateVersion
        this.menuVersion = menuVersion
        this.members = members
        this.self = self
        this.recommendation = recommendation
        this.recommendationInvalid = recommendationInvalid
        this.job = job
        this.messages = messages
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("session", session.toJson())
        obj.put("restaurantCode", JsonString(restaurantCode))
        obj.put("stateVersion", JsonInt(stateVersion))
        obj.put("menuVersion", JsonInt(menuVersion))
        obj.put("members", JsonArray(members.map({item => item.toJson() })))
        obj.put("self", match (self) { case Some(v) => v.toJson(); case None => JsonNull() })
        obj.put("recommendation", match (recommendation) { case Some(v) => v.toJson(); case None => JsonNull() })
        obj.put("recommendationInvalid", JsonBool(recommendationInvalid))
        obj.put("job", match (job) { case Some(v) => v.toJson(); case None => JsonNull() })
        obj.put("messages", JsonArray(messages.map({item => item.toJson() })))
        return obj
    }

    public static func fromJson(obj: JsonObject): RoomSnapshot {
        return RoomSnapshot(session: Session.fromJson(obj["session"].asObject()),
            restaurantCode: obj["restaurantCode"].asString().getValue(),
            stateVersion: obj["stateVersion"].asInt().getValue(),
            menuVersion: obj["menuVersion"].asInt().getValue(),
            members: obj["members"].asArray().getItems().toArray().map({item => ParticipantView.fromJson(item.asObject()) }),
            self: match (obj["self"]) { case _: JsonNull => None; case _ => Some(Participant.fromJson(obj["self"].asObject())) },
            recommendation: match (obj["recommendation"]) { case _: JsonNull => None; case _ => Some(Recommendation.fromJson(obj["recommendation"].asObject())) },
            recommendationInvalid: obj["recommendationInvalid"].asBool().getValue(),
            job: match (obj["job"]) { case _: JsonNull => None; case _ => Some(RecommendationJob.fromJson(obj["job"].asObject())) },
            messages: obj["messages"].asArray().getItems().toArray().map({item => ChatMessage.fromJson(item.asObject()) }))
    }
}

public class StoreConfig {
    public var path: String

    public init(path!: String = "") {
        this.path = path
    }

}

public class DatabaseSnapshot {
    public var mealMetadata: Array<DishMealFacts>
    public var schemaVersion: Int64
    public var users: Array<UserAccount>
    public var merchants: Array<MerchantAccount>
    public var authSessions: Array<StoredAuthSession>
    public var visitorSessions: Array<StoredVisitorSession>
    public var defaultSettings: Array<UserDefaultSettings>
    public var restaurants: Array<Restaurant>
    public var menuVersions: Array<MenuVersion>
    public var dishes: Array<Dish>
    public var setMeals: Array<SetMeal>
    public var sessions: Array<Session>
    public var participants: Array<Participant>
    public var recommendations: Array<Recommendation>
    public var chatMessages: Array<ChatMessage>
    public var dedupeRecords: Array<DedupeRecord>
    public var jobs: Array<RecommendationJob>

    public init(mealMetadata!: Array<DishMealFacts> = [],
        schemaVersion!: Int64 = 1,
        users!: Array<UserAccount> = [],
        merchants!: Array<MerchantAccount> = [],
        authSessions!: Array<StoredAuthSession> = [],
        visitorSessions!: Array<StoredVisitorSession> = [],
        defaultSettings!: Array<UserDefaultSettings> = [],
        restaurants!: Array<Restaurant> = [],
        menuVersions!: Array<MenuVersion> = [],
        dishes!: Array<Dish> = [],
        setMeals!: Array<SetMeal> = [],
        sessions!: Array<Session> = [],
        participants!: Array<Participant> = [],
        recommendations!: Array<Recommendation> = [],
        chatMessages!: Array<ChatMessage> = [],
        dedupeRecords!: Array<DedupeRecord> = [],
        jobs!: Array<RecommendationJob> = []) {
        this.mealMetadata = mealMetadata
        this.schemaVersion = schemaVersion
        this.users = users
        this.merchants = merchants
        this.authSessions = authSessions
        this.visitorSessions = visitorSessions
        this.defaultSettings = defaultSettings
        this.restaurants = restaurants
        this.menuVersions = menuVersions
        this.dishes = dishes
        this.setMeals = setMeals
        this.sessions = sessions
        this.participants = participants
        this.recommendations = recommendations
        this.chatMessages = chatMessages
        this.dedupeRecords = dedupeRecords
        this.jobs = jobs
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("mealMetadata", JsonArray(mealMetadata.map({item => item.toJson() })))
        obj.put("schemaVersion", JsonInt(schemaVersion))
        obj.put("users", JsonArray(users.map({item => item.toJson() })))
        obj.put("merchants", JsonArray(merchants.map({item => item.toJson() })))
        obj.put("authSessions", JsonArray(authSessions.map({item => item.toJson() })))
        obj.put("visitorSessions", JsonArray(visitorSessions.map({item => item.toJson() })))
        obj.put("defaultSettings", JsonArray(defaultSettings.map({item => item.toJson() })))
        obj.put("restaurants", JsonArray(restaurants.map({item => item.toJson() })))
        obj.put("menuVersions", JsonArray(menuVersions.map({item => item.toJson() })))
        obj.put("dishes", JsonArray(dishes.map({item => item.toJson() })))
        obj.put("setMeals", JsonArray(setMeals.map({item => item.toJson() })))
        obj.put("sessions", JsonArray(sessions.map({item => item.toJson() })))
        obj.put("participants", JsonArray(participants.map({item => item.toJson() })))
        obj.put("recommendations", JsonArray(recommendations.map({item => item.toJson() })))
        obj.put("chatMessages", JsonArray(chatMessages.map({item => item.toJson() })))
        obj.put("dedupeRecords", JsonArray(dedupeRecords.map({item => item.toJson() })))
        obj.put("jobs", JsonArray(jobs.map({item => item.toJson() })))
        return obj
    }

    public static func fromJson(obj: JsonObject): DatabaseSnapshot {
        if (obj["schemaVersion"].asInt().getValue() != 1) { throw Exception("Unsupported database schema") }
        return DatabaseSnapshot(mealMetadata: if (obj.containsKey("mealMetadata")) { obj["mealMetadata"].asArray().getItems().toArray().map({item => DishMealFacts.fromJson(item.asObject()) }) } else { [] },
            schemaVersion: obj["schemaVersion"].asInt().getValue(),
            users: obj["users"].asArray().getItems().toArray().map({item => UserAccount.fromJson(item.asObject()) }),
            merchants: obj["merchants"].asArray().getItems().toArray().map({item => MerchantAccount.fromJson(item.asObject()) }),
            authSessions: obj["authSessions"].asArray().getItems().toArray().map({item => StoredAuthSession.fromJson(item.asObject()) }),
            visitorSessions: obj["visitorSessions"].asArray().getItems().toArray().map({item => StoredVisitorSession.fromJson(item.asObject()) }),
            defaultSettings: obj["defaultSettings"].asArray().getItems().toArray().map({item => UserDefaultSettings.fromJson(item.asObject()) }),
            restaurants: obj["restaurants"].asArray().getItems().toArray().map({item => Restaurant.fromJson(item.asObject()) }),
            menuVersions: obj["menuVersions"].asArray().getItems().toArray().map({item => MenuVersion.fromJson(item.asObject()) }),
            dishes: obj["dishes"].asArray().getItems().toArray().map({item => Dish.fromJson(item.asObject()) }),
            setMeals: obj["setMeals"].asArray().getItems().toArray().map({item => SetMeal.fromJson(item.asObject()) }),
            sessions: obj["sessions"].asArray().getItems().toArray().map({item => Session.fromJson(item.asObject()) }),
            participants: obj["participants"].asArray().getItems().toArray().map({item => Participant.fromJson(item.asObject()) }),
            recommendations: obj["recommendations"].asArray().getItems().toArray().map({item => Recommendation.fromJson(item.asObject()) }),
            chatMessages: obj["chatMessages"].asArray().getItems().toArray().map({item => ChatMessage.fromJson(item.asObject()) }),
            dedupeRecords: obj["dedupeRecords"].asArray().getItems().toArray().map({item => DedupeRecord.fromJson(item.asObject()) }),
            jobs: obj["jobs"].asArray().getItems().toArray().map({item => RecommendationJob.fromJson(item.asObject()) }))
    }
}
