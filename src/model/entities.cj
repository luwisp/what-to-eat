public class RecommendationDraft {
    public var mealStatus: String
    public var estimatedHotNeed: Int64
    public var estimatedHotSupply: Int64
    public var mealMembers: Array<MealAllocation>
    public var items: Array<RecommendationItem>
    public var expandedDishes: Array<ExpandedDish>
    public var fits: Array<DishFit>
    public var totalFen: Int64
    public var undercoveredIds: Array<String>
    public var uncoveredIds: Array<String>
    public var unmetWishes: Array<UnmetWish>
    public var budgetWarning: ?String
    public var notices: Array<String>
    public var associations: IngredientAssociations

    public init(mealStatus!: String = "legacy",
        estimatedHotNeed!: Int64 = 0,
        estimatedHotSupply!: Int64 = 0,
        mealMembers!: Array<MealAllocation> = [],
        items!: Array<RecommendationItem> = [],
        expandedDishes!: Array<ExpandedDish> = [],
        fits!: Array<DishFit> = [],
        totalFen!: Int64 = 0,
        undercoveredIds!: Array<String> = [],
        uncoveredIds!: Array<String> = [],
        unmetWishes!: Array<UnmetWish> = [],
        budgetWarning!: ?String = None,
        notices!: Array<String> = [],
        associations!: IngredientAssociations = IngredientAssociations()) {
        this.mealStatus = mealStatus
        this.estimatedHotNeed = estimatedHotNeed
        this.estimatedHotSupply = estimatedHotSupply
        this.mealMembers = mealMembers
        this.items = items
        this.expandedDishes = expandedDishes
        this.fits = fits
        this.totalFen = totalFen
        this.undercoveredIds = undercoveredIds
        this.uncoveredIds = uncoveredIds
        this.unmetWishes = unmetWishes
        this.budgetWarning = budgetWarning
        this.notices = notices
        this.associations = associations
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("mealStatus", JsonString(mealStatus))
        obj.put("estimatedHotNeed", JsonInt(estimatedHotNeed))
        obj.put("estimatedHotSupply", JsonInt(estimatedHotSupply))
        obj.put("mealMembers", JsonArray(mealMembers.map({item => item.toJson() })))
        obj.put("items", JsonArray(items.map({item => item.toJson() })))
        obj.put("expandedDishes", JsonArray(expandedDishes.map({item => item.toJson() })))
        obj.put("fits", JsonArray(fits.map({item => item.toJson() })))
        obj.put("totalFen", JsonInt(totalFen))
        obj.put("undercoveredIds", JsonArray(undercoveredIds.map({item => JsonString(item) })))
        obj.put("uncoveredIds", JsonArray(uncoveredIds.map({item => JsonString(item) })))
        obj.put("unmetWishes", JsonArray(unmetWishes.map({item => item.toJson() })))
        obj.put("budgetWarning", match (budgetWarning) { case Some(v) => JsonString(v); case None => JsonNull() })
        obj.put("notices", JsonArray(notices.map({item => JsonString(item) })))
        obj.put("associations", associations.toJson())
        return obj
    }

    public static func fromJson(obj: JsonObject): RecommendationDraft {
        return RecommendationDraft(mealStatus: if (obj.containsKey("mealStatus")) { obj["mealStatus"].asString().getValue() } else { "legacy" },
            estimatedHotNeed: if (obj.containsKey("estimatedHotNeed")) { obj["estimatedHotNeed"].asInt().getValue() } else { 0 },
            estimatedHotSupply: if (obj.containsKey("estimatedHotSupply")) { obj["estimatedHotSupply"].asInt().getValue() } else { 0 },
            mealMembers: if (obj.containsKey("mealMembers")) { obj["mealMembers"].asArray().getItems().toArray().map({item => MealAllocation.fromJson(item.asObject()) }) } else { [] },
            items: obj["items"].asArray().getItems().toArray().map({item => RecommendationItem.fromJson(item.asObject()) }),
            expandedDishes: obj["expandedDishes"].asArray().getItems().toArray().map({item => ExpandedDish.fromJson(item.asObject()) }),
            fits: obj["fits"].asArray().getItems().toArray().map({item => DishFit.fromJson(item.asObject()) }),
            totalFen: obj["totalFen"].asInt().getValue(),
            undercoveredIds: obj["undercoveredIds"].asArray().getItems().toArray().map({item => item.asString().getValue() }),
            uncoveredIds: obj["uncoveredIds"].asArray().getItems().toArray().map({item => item.asString().getValue() }),
            unmetWishes: obj["unmetWishes"].asArray().getItems().toArray().map({item => UnmetWish.fromJson(item.asObject()) }),
            budgetWarning: match (obj["budgetWarning"]) { case _: JsonNull => None; case _ => Some(obj["budgetWarning"].asString().getValue()) },
            notices: obj["notices"].asArray().getItems().toArray().map({item => item.asString().getValue() }),
            associations: IngredientAssociations.fromJson(obj["associations"].asObject()))
    }
}

public class Recommendation {
    public var id: String
    public var sessionId: String
    public var roomVersion: Int64
    public var menuVersion: Int64
    public var mode: String
    public var draft: RecommendationDraft
    public var canConfirm: Bool
    public var createdAt: Int64
    public var accepted: Bool

    public init(id!: String = "",
        sessionId!: String = "",
        roomVersion!: Int64 = 0,
        menuVersion!: Int64 = 0,
        mode!: String = "rules",
        draft!: RecommendationDraft = RecommendationDraft(),
        canConfirm!: Bool = false,
        createdAt!: Int64 = 0,
        accepted!: Bool = false) {
        this.id = id
        this.sessionId = sessionId
        this.roomVersion = roomVersion
        this.menuVersion = menuVersion
        this.mode = mode
        this.draft = draft
        this.canConfirm = canConfirm
        this.createdAt = createdAt
        this.accepted = accepted
    }

    public func toJson(): JsonObject {
        let obj = JsonObject()
        obj.put("id", JsonString(id))
        obj.put("sessionId", JsonString(sessionId))
        obj.put("roomVersion", JsonInt(roomVersion))
        obj.put("menuVersion", JsonInt(menuVersion))
        obj.put("mode", JsonString(mode))
        obj.put("draft", draft.toJson())
        obj.put("canConfirm", JsonBool(canConfirm))
        obj.put("createdAt", JsonInt(createdAt))
        obj.put("accepted", JsonBool(accepted))
        return obj
    }

    public static func fromJson(obj: JsonObject): Recommendation {
        return Recommendation(id: obj["id"].asString().getValue(),
            sessionId: obj["sessionId"].asString().getValue(),
            roomVersion: obj["roomVersion"].asInt().getValue(),
            menuVersion: obj["menuVersion"].asInt().getValue(),
            mode: obj["mode"].asString().getValue(),
            draft: RecommendationDraft.fromJson(obj["draft"].asObject()),
            canConfirm: obj["canConfirm"].asBool().getValue(),
            createdAt: obj["createdAt"].asInt().getValue(),
            accepted: obj["accepted"].asBool().getValue())
    }
}

