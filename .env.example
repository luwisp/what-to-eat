JUXIAOBAO_HOST=127.0.0.1
JUXIAOBAO_PORT=8080
JUXIAOBAO_PUBLIC_BASE_URL=http://127.0.0.1:8080
JUXIAOBAO_DB_PATH=data/runtime/juxiaobao.sqlite
# Optional image storage directory; default is JUXIAOBAO_DB_PATH + .uploads.
# JUXIAOBAO_IMAGE_DIR=data/runtime/menu-uploads
# Set your own SDK directory; scripts/cj.sh also recognizes CANGJIE_HOME.
# JUXIAOBAO_CANGJIE_SDK=/path/to/cangjie
# Optional. Empty key or model => deterministic rules, chat disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
